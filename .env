# Which environment the app runs in: development, staging or production.
# A production build defaults to production.
VITE_APP_ENVIRONMENT = "development"

# Which API to talk to: development, staging or production.
# Defaults to VITE_APP_ENVIRONMENT.
VITE_API_ENVIRONMENT = "production"

# API addresses, one per environment. These are the API's root URL;
# the app adds /api/ itself. VITE_API_BASE_URL is used when the matching one is empty.
VITE_DEV_API_BASE_URL = "http://127.0.0.1:8001"
VITE_STAGING_API_BASE_URL = ""
VITE_PROD_API_BASE_URL = "https://api.app.toneflix.net"
VITE_API_BASE_URL = "https://api.app.toneflix.net"

# This app's public address
VITE_FRONT_URL = "https://app.toneflix.net"

# Setup docs, linked from the admin menu. Leave empty to hide the link.
VITE_DOCS_URL = "https://toneflix-collab-docs.pages.dev/"

# DEBUGGING
VITE_DEBUG = true
VITE_LOG_LEVEL = error
