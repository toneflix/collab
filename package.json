{
  "name": "toneflix-collab",
  "version": "1.1.6-beta",
  "build": 44,
  "description": "A music community for listening, discovering artists and making music together.",
  "productName": "Toneflix Music",
  "author": "toneflix<code@toneflix.com.ng>",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "echo \"No test specified\" && exit 0",
    "dev": "quasar dev",
    "build": "quasar build",
    "build:worker": "SSR_TARGET=cloudflare quasar build -m ssr",
    "worker:dev": "yarn build:worker && wrangler dev",
    "worker:deploy": "yarn build:worker && wrangler deploy",
    "typecheck": "vue-tsc --noEmit",
    "icons:web": "icongenie generate -m spa,ssr -i src-icongenie/logo.png",
    "icons:app": "icongenie generate -m capacitor -f png -i src-icongenie/logo-square-filled.png --skip-trim --theme-color d5a301",
    "build:android": "quasar build -m android --skip-pkg",
    "dev:android": "quasar dev -m android",
    "build:ios": "quasar build -m ios --skip-pkg",
    "dev:ios": "quasar dev -m ios",
    "postinstall": "quasar prepare --silent"
  },
  "dependencies": {
    "@alova/adapter-axios": "^2.0.20",
    "@arkstack/realtime": "0.20.2",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@dawcore/components": "0.0.37",
    "@dawcore/faust": "0.0.1",
    "@dawcore/transport": "0.0.14",
    "@dawcore/wam": "0.0.3",
    "@douxcode/vue-spring-bottom-sheet": "^3.2.0",
    "@fontsource-variable/inter": "5.3.0",
    "@lucide/vue": "1.61.0",
    "@toneflix/paystack-inline": "^1.11.5",
    "@videojs/html": "10.2.0",
    "@vue/devtools-api": "^8.2.1",
    "@vueuse/core": "^14.1.0",
    "@waveform-playlist/core": "12.6.1",
    "@waveform-playlist/engine": "13.6.0",
    "@waveform-playlist/worklets": "13.0.0",
    "alova": "^3.5.5",
    "atropos": "^2.0.2",
    "axios": "^1.20.0",
    "cropperjs": "^1.6.2",
    "firebase": "^11.10.0",
    "javascript-time-ago": "^2.6.4",
    "lit": "3.3.3",
    "marked": "^15",
    "pinia": "^4.1.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "pusher-js": "^8.4.0",
    "qrcode": "1.5.4",
    "quasar": "^2.35.2",
    "sortablejs": "1.15.6",
    "tippy.js": "^6.3.7",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-picture-cropper": "^1.0.0",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@quasar/app-vite": "^3.10.3",
    "@quasar/icongenie": "^7.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/event-emitter": "^0.3.5",
    "@types/node": "^22.19.11",
    "@types/qrcode": "1.5.5",
    "@types/sortablejs": "^1.15.9",
    "@types/virtual-dom": "^2.1.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.4.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.0",
    "vite": "^8.3.0",
    "vite-plugin-checker": "^0.14.5",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "node": ">= 26 || ^24 || ^22.12",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  },
  "packageManager": "yarn@1.22.22+sha1.ac34549e6aa8e7ead463a7407e1c7390f61a6610"
}
